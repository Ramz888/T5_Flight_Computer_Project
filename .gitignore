# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.spec

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Large recorded flight media & logs (keep directory structure with .gitkeep)
flight_recordings/*.mp4
flight_recordings/*.avi
flight_recordings/*.mkv
flight_recordings/*.jpg
flight_recordings/*.png
!flight_recordings/.gitkeep

**/flight_recordings/*.mp4
**/flight_recordings/*.avi
**/flight_recordings/*.mkv
**/flight_recordings/*.jpg
**/flight_recordings/*.png
!**/flight_recordings/.gitkeep

# Live telemetry logs from testing
telemetry_logs/*.csv
!telemetry_logs/.gitkeep
**/telemetry_logs/*.csv
!**/telemetry_logs/.gitkeep

# Arduino & C++ build artifacts
build/
*.bin
*.hex
*.elf
*.o
*.d
*.map

# Editor & OS files
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
